{
  "version": 2,
  "cleanUrls": true,
  "installCommand": "echo 'Static frontend - skipping python dependencies'",
  "buildCommand": "echo 'Static build complete'",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
